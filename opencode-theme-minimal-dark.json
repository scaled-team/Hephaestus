{
  "$schema": "https://opencode.ai/theme.json",
  "name": "minimal-dark",
  "description": "Minimal dark theme optimized for readability",
  "defs": {
    "white": "#ffffff",
    "black": "#000000",
    "dark-bg": "#1a1a1a",
    "dark-panel": "#2a2a2a",
    "dark-element": "#333333",
    "light-text": "#e0e0e0",
    "muted-text": "#a0a0a0",
    "primary-blue": "#5a9fd4",
    "success-green": "#5fa050",
    "warning-orange": "#d4a05a",
    "error-red": "#d45a5a"
  },
  "theme": {
    "primary": "primary-blue",
    "secondary": "#6ba3d8",
    "accent": "#5fa050",
    "error": "error-red",
    "warning": "warning-orange",
    "success": "success-green",
    "info": "primary-blue",
    "text": "light-text",
    "textMuted": "muted-text",
    "background": "dark-bg",
    "backgroundPanel": "dark-panel",
    "backgroundElement": "dark-element",
    "border": "#404040",
    "borderActive": "primary-blue",
    "borderSubtle": "#303030",
    "diffAdded": "#1a4d1a",
    "diffRemoved": "#4d1a1a",
    "diffContext": "dark-panel",
    "diffHunkHeader": "#303080",
    "markdownText": "light-text",
    "markdownHeading": "primary-blue",
    "markdownLink": "#5a9fd4",
    "markdownCode": "#6ba3d8",
    "syntaxComment": "#708070",
    "syntaxKeyword": "primary-blue",
    "syntaxFunction": "#6ba3d8",
    "syntaxString": "success-green",
    "syntaxNumber": "warning-orange"
  }
}
