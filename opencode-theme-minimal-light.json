{
  "$schema": "https://opencode.ai/theme.json",
  "name": "minimal-light",
  "description": "Minimal light theme optimized for readability",
  "defs": {
    "white": "#ffffff",
    "black": "#000000",
    "light-bg": "#f8f8f8",
    "light-panel": "#efefef",
    "light-element": "#e8e8e8",
    "dark-text": "#1a1a1a",
    "muted-text": "#666666",
    "primary-blue": "#0066cc",
    "success-green": "#006600",
    "warning-orange": "#cc6600",
    "error-red": "#cc0000"
  },
  "theme": {
    "primary": "primary-blue",
    "secondary": "#3385dd",
    "accent": "success-green",
    "error": "error-red",
    "warning": "warning-orange",
    "success": "success-green",
    "info": "primary-blue",
    "text": "dark-text",
    "textMuted": "muted-text",
    "background": "light-bg",
    "backgroundPanel": "light-panel",
    "backgroundElement": "light-element",
    "border": "#d0d0d0",
    "borderActive": "primary-blue",
    "borderSubtle": "#e0e0e0",
    "diffAdded": "#d0f0d0",
    "diffRemoved": "#f0d0d0",
    "diffContext": "light-panel",
    "diffHunkHeader": "#d0d0f0",
    "markdownText": "dark-text",
    "markdownHeading": "primary-blue",
    "markdownLink": "#0066cc",
    "markdownCode": "#3385dd",
    "syntaxComment": "#909090",
    "syntaxKeyword": "primary-blue",
    "syntaxFunction": "#3385dd",
    "syntaxString": "success-green",
    "syntaxNumber": "warning-orange"
  }
}
